# Application

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Mesca CL

NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos

# Admin Authentication

ADMIN_EMAIL=admin@example.com

# Session Security

JWT_SECRET=replace-this-with-a-long-random-string

SESSION_COOKIE_NAME=mesca_session

SESSION_MAX_AGE=14400

# COOKIE_SECURE=true

# Database (Turso). Leave unset to use local ./database/mesca.db

# TURSO_DATABASE_URL=libsql://your-db.turso.io

# TURSO_AUTH_TOKEN=your-turso-auth-token

# DATABASE_FILE=./database/mesca.db

# Cloudflare R2 (media storage). Leave unset to use local public/uploads in dev.

# R2_ACCOUNT_ID=

# R2_ACCESS_KEY_ID=

# R2_SECRET_ACCESS_KEY=

# R2_BUCKET_NAME=

# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Contact Form

CONTACT_EMAIL=contact@example.com

# Phone & WhatsApp

PHONE_NUMBER=+10000000000

WHATSAPP_NUMBER=+10000000000

WHATSAPP_PRESET_MESSAGE=Hello Mesca CL, I found your website and would like to get in touch.

# Optional: Email provider

# SMTP_HOST=

# SMTP_PORT=

# SMTP_USER=

# SMTP_PASS=

# SMTP_FROM=

# Optional: Payment provider

# PAYMENT_PROVIDER_SECRET_KEY=

# PAYMENT_PROVIDER_PUBLIC_KEY=

# Optional: Analytics

# NEXT_PUBLIC_ANALYTICS_ID=

